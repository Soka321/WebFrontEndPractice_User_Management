@model WebFrontEndPractice.Models.User
@{
    ViewData["Title"] = "Add User";
}

<h2>Add User</h2>

<form asp-action="AddUser" method="post">
    <div class="mb-3">
        <label class="form-label">Name</label>
        <input class="form-control" asp-for="Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Surname</label>
        <input class="form-control" asp-for="Surname" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" asp-for="Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <input class="form-control" asp-for="Password" type="password" />
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <input class="form-control" asp-for="Role" />
    </div>
    <button class="btn btn-secondary" type="submit">Create</button>
</form>